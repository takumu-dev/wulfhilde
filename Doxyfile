# The reference for the engine's public headers. Run Doxygen from the repository's root, or build
# the `docs` target. Every public declaration must be documented, and any warning fails the run.

PROJECT_NAME           = wulfhilde
PROJECT_BRIEF          = "A library for games built from sectors joined by portals"

# Each module's public include tree.
INPUT                  = src/core/include \
                         src/world/include
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp
STRIP_FROM_PATH        = src/core/include \
                         src/world/include
STRIP_FROM_INC_PATH    = src/core/include \
                         src/world/include

# Knows the standard library's classes, so that a specialisation such as std::formatter has a
# scope to be documented in.
BUILTIN_STL_SUPPORT    = YES

JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
QUIET                  = YES

OUTPUT_DIRECTORY       = build/docs
GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# No diagrams, so the check needs no Graphviz.
HAVE_DOT               = NO
