{
  "$schema": "../../../schema/map.schema.json",
  "format": "wulfhilde-map",
  "version": 1.0,
  "ambient": { "color": [0.5, 0.75, 1], "lux": 20 },
  "exposure": { "min": -2.5, "max": 12, "compensation": 0.5 },
  "sectors": [
    {
      "id": "hall",
      "floor": {
        "height": -0.5,
        "material": "stone/floor",
        "offset": [0.25, 0.5],
        "scale": [2, 3],
        "rotation": 90,
        "nits": 12.5,
        "slope": { "hinge": "hall-east", "gradient": 0.25 }
      },
      "ceiling": { "height": 3, "material": "plaster" },
      "ambient": { "color": [1, 0.5, 0.25], "lux": 5 },
      "loops": [
        [
          { "start": [0, 0], "surface": { "material": "brick" } },
          {
            "id": "hall-east",
            "start": [4, 0],
            "surface": { "material": "brick/dark", "offset": [1, 2], "scale": [0.5, 4], "rotation": -45 },
            "upper": { "material": "plaster", "offset": [0, 0.5], "nits": 30 },
            "properties": { "switch": "lights" }
          },
          { "start": [4, 4], "surface": { "material": "brick" } },
          { "start": [0, 4], "surface": { "material": "stone/floor" } }
        ],
        [
          { "start": [1, 1], "surface": { "material": "brick" } },
          { "start": [1, 2], "surface": { "material": "brick" } },
          { "start": [2, 2], "surface": { "material": "brick" } },
          { "start": [2, 1], "surface": { "material": "brick" } }
        ]
      ],
      "properties": {
        "secret": true,
        "notes": ["a } and a \" in a string", { "nested": [1, 2.5e1, null] }]
      }
    },
    {
      "id": "closet",
      "floor": { "height": 0, "sky": { "backdrop": "sky/abyss" } },
      "ceiling": {
        "height": 2.5,
        "sky": { "backdrop": "sky/dusk", "nits": 50 },
        "slope": { "hinge": "closet-west", "gradient": -0.5 }
      },
      "loops": [
        [
          { "id": "closet-vault", "start": [4, 0], "surface": { "material": "brick" } },
          { "start": [6, 2], "surface": { "material": "brick" } },
          {
            "id": "closet-west",
            "start": [4, 4],
            "surface": { "material": "brick" },
            "lower": { "material": "brick", "rotation": 90 }
          }
        ]
      ]
    },
    {
      "id": "vault",
      "floor": { "height": 0, "material": "brick" },
      "ceiling": { "height": 3, "material": "brick" },
      "loops": [
        [
          { "id": "vault-closet", "start": [18, 6], "surface": { "material": "brick" } },
          { "start": [20, 4], "surface": { "material": "brick" } },
          { "start": [20, 6], "surface": { "material": "brick" } }
        ]
      ]
    }
  ],
  "portals": [
    { "a": { "wall": "hall-east" }, "b": { "wall": "closet-west" }, "properties": { "sound": "creak" } },
    {
      "a": { "wall": "closet-vault" },
      "b": { "wall": "vault-closet" },
      "transform": { "translation": [20, 0, 1], "rotation": { "yaw": 90, "pitch": 0, "roll": 0 } }
    }
  ],
  "start": { "sector": "closet", "point": [4.5, 2, 0], "yaw": 180, "pitch": -10 },
  "properties": {}
}
